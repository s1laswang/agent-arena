# Copy to .env (gitignored). Never commit real keys, never print them in logs or reports.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Default models (override per run)
CANARY_GEMINI_MODEL=gemini-4-carbon
# CANARY_GEMINI_THINKING_LEVEL=   # low|medium|high (unset = model default; gemini-4-carbon: medium)
CANARY_OPENAI_MODEL=gpt-5
