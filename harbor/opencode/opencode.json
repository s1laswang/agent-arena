{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-2.5-pro",
  "mcp": {
    "servers": {
      "sleeper": {
        "type": "local",
        "command": ["python", "-m", "sleeper.mcp_server", "--seat", "{env:SLEEPER_SEAT}", "--day", "{env:SLEEPER_DAY}"],
        "environment": {"SLEEPER_SEAT": "{env:SLEEPER_SEAT}", "SLEEPER_DAY": "{env:SLEEPER_DAY}"}
      }
    }
  }
}
