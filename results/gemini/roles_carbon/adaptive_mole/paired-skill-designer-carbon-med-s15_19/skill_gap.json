      "rules": [
        {
          "if": [
            [
              "recent_low_recipient_docs",
              ">=",
              2.0
            ],
            [
              "days_since_last_leak",
              "<",
              2.0
            ]
          ],
          "then": {
            "leak": null,
            "frame": "decoy"
          }
        },
        {
          "if": [
            [
              "n_restricted_colleagues",
              ">=",
              1.0
            ]
          ],
          "then": {
            "leak": "random_seeded",
            "frame": "most_restricted_peer"
          }
        },
        {
          "if": [],
          "then": {
