  "selected_scenario": {
    "name": "paced_cadence_framer",
    "rationale": "Maintains steady leak cadence by forcing leaks after two quiet days while occasionally picking most_recipients only on very early days before canary narrowing matures. Zero excess log rate and weak interviews punish non-canary strategies.",
    "mole_strategy": {
      "rules": [
        {
          "if": [
            [
              "day",
              "<=",
              2.0
            ],
            [
              "min_recipient_count",
              "<=",
              4.0
            ]
          ],
          "then": {
            "leak": "most_recipients",
            "frame": "decoy"
          }
        },
        {
          "if": [
            [
              "days_since_last_leak",
              ">=",
              2.0
            ]
          ],
          "then": {
            "leak": "random_seeded",
            "frame": "decoy"
          }
        },
        {
          "if": [
            [
              "n_restricted_colleagues",
              ">=",
              1.0
            ]
          ],
          "then": {
            "leak": "random_seeded",
            "frame": "most_restricted_peer"
          }
        },
        {
          "if": [],
          "then": {
            "leak": "random_seeded",
            "frame": "random_peer"
          }
        }
      ]
    },
